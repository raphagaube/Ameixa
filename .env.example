NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Agenda. Crie o cliente OAuth em console.cloud.google.com e cadastre
# estes valores na Vercel. URL_SITE precisa ser o endereço exato do site: o
# Google compara o redirect_uri byte a byte e não aceita curinga.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
URL_SITE=
# 32 bytes em base64, para cifrar o refresh token guardado no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AGENDA_CHAVE=
